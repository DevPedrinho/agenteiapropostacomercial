# Geração da ficha de produto (obrigatória para a página inicial)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Integração com o Bling (montador de orçamento, /orcamento).
# Crie um aplicativo em https://developer.bling.com.br (Meus aplicativos) com a
# URL de redirecionamento: https://SEU-DOMINIO/api/bling/callback
# e escopo de leitura de Produtos e Estoques.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# Chave usada para criptografar o token do Bling no cookie do vendedor.
# Opcional: sem ela, deriva do client secret. Troque para invalidar todas as sessões.
# BLING_TOKEN_SECRET=
# Só para testes: URL base alternativa da API (padrão https://www.bling.com.br/Api/v3).
# BLING_API_BASE_URL=
